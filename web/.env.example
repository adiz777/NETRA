# Authentication: set unique values locally; configure as server-side secrets in production.
NETRA_USERNAME=replace_with_your_operator_id
NETRA_PASSWORD=replace_with_a_long_unique_password
NETRA_SESSION_SECRET=replace_with_a_random_secret_at_least_32_bytes

# Hosted AI only. Never commit real keys.
NETRA_LLM_API_KEY=
NETRA_LLM_MODEL=
NETRA_LLM_BASE_URL=https://api.groq.com/openai/v1
NETRA_LLM_PROVIDER=groq
